# Leavo configuration (contracts/configuration.md). Copy to .env and fill in.

# --- Required ---------------------------------------------------------------------------------
# Database password used by docker-compose.yml (pick a long random one).
DB_PASSWORD=change-me
# Without Docker, set DATABASE_URL instead, e.g. postgres://leavo:leavo@localhost:5432/leavo
# DATABASE_URL=postgres://leavo:leavo@localhost:5432/leavo
# The public address people open, used in email links.
LEAVO_BASE_URL=http://localhost:8080
# 64+ random characters: `openssl rand -hex 32`. Changing it signs everyone out.
LEAVO_SECRET_KEY=change-me-change-me-change-me-change-me-change-me-change-me-000000
# smtps://user:pass@host:465 or smtp://host:587?tls=required (smtp://localhost:1025 for Mailpit)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Leavo <leave@localhost>

# --- Optional ---------------------------------------------------------------------------------
# LEAVO_MODE=single
# LEAVO_RUN_JOBS=true
# STORAGE=local            # or s3 with S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY
# STORAGE_LOCAL_PATH=/data/uploads
# LEAVO_UPDATE_CHECK=true  # false: never contact GitHub for new releases
# LEAVO_METRICS_TOKEN=     # when set, /metrics needs "Authorization: Bearer <token>"
# LOG_LEVEL=info
