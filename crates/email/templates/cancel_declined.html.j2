{% extends "layout.html.j2" %}
{% block content %}
<p>Hi {{ requester }},</p>
<p><strong>{{ decided_by }}</strong> declined your request to cancel <strong>{{ leave_type }}</strong> for <strong>{{ dates }}</strong> ({{ days_text }}). The leave stays approved.</p>
{% if comment %}<p style="padding:8px 12px;background:#f6f7f9;border-radius:6px;">{{ comment }}</p>{% endif %}
<p><a href="{{ base_url }}/leave/history">See your leave in Leavo</a></p>
{% endblock %}
