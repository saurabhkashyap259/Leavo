<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Leavo{% endblock %}</title>
</head>
<body style="margin:0;padding:24px;background:#f6f7f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1f2937;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;">
<tr><td style="padding:24px 28px;font-size:15px;line-height:1.5;">
{% block content %}{% endblock %}
</td></tr>
<tr><td style="padding:12px 28px 20px;font-size:12px;color:#6b7280;">{% block footer %}Sent by Leavo{% if org_name %} for {{ org_name }}{% endif %}.{% endblock %}</td></tr>
</table>
</body>
</html>
