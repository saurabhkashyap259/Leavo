{% extends "layout.html.j2" %}
{% block content %}
<p><strong>{{ requester }}</strong>'s <strong>{{ leave_type }}</strong> for <strong>{{ dates }}</strong> ({{ days_text }}) has already started, and they ask to cancel the rest.</p>
<p>If you accept, {{ returned_text }} from {{ requested_on }} onward go back to their balance. Earlier days stay taken. If you decline, the leave stays as approved.</p>
{% if reason %}<p style="padding:8px 12px;background:#f6f7f9;border-radius:6px;">{{ reason }}</p>{% endif %}
<p><a href="{{ inbox_url }}" style="display:inline-block;padding:10px 18px;background:#1d4ed8;color:#ffffff;border-radius:6px;text-decoration:none;font-weight:600;">Decide in Leavo</a></p>
{% endblock %}
